<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
          @if(auth.user)
            @if(auth.user.isAdmin)
              @link({ route: 'admin.users.index', class: 'btn btn--primary btn--sm' })
                Uživatelé
              @end
            @end
            @form({ route: 'session.destroy', method: 'POST' })
              <button type="submit" class="btn btn--secondary btn--sm">
                @svg('lucide:log-out', { width: 15, height: 15 })
                Log out
              </button>
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Sign in
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Get started
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
